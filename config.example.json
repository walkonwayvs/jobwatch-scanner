    { "name": "Third Co",   "type": "ashby",      "token": "third-company" },
    { "name": "Fourth Co",  "type": "recruitee",  "token": "fourthcompany" }
  ],

  "broad_boards": [
    { "name": "RemoteOK",       "type": "remoteok", "url": "https://remoteok.com/api" },
    { "name": "WeWorkRemotely", "type": "rss",      "url": "https://weworkremotely.com/remote-jobs.rss" }
  ],

  "github_repos": [
    { "repo": "owner/repo-you-care-about" },
    { "repo": "owner/another-repo", "branch": "master" }
