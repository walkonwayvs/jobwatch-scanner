  "role_keywords": [
    "qa", "quality assurance", "test engineer", "testing engineer",
    "sdet", "test automation", "node operator", "infrastructure engineer",
    "devnet", "vacancy", "hiring", "job posting", "open role"
  ],

  "domain_keywords": [
    "crypto", "web3", "blockchain", "protocol", "node", "validator",
    "decentralized", "depin", "defi", "testnet", "onchain",
    "cosmos", "ethereum", "solana", "usdc", "usdt", "stablecoin"
